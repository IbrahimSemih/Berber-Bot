# Kopyalayın: cp .env.local.example .env.local  — gerçek değerleri ASLA commit etmeyin.

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Uygulama ──────────────────────────────────────────────────────────────
# Lokalde http://localhost:3000; ödeme callback yönlendirmeleri bu adresi kullanır
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Cron uç noktaları için: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── Superadmin (/superadmin) ──────────────────────────────────────────────
SUPERADMIN_EMAIL=
# Tercih edilen: bcrypt hash. Üretmek için:
#   node -e "console.log(require('bcryptjs').hashSync('SIFRE', 12))"
# Tanımlıysa SUPERADMIN_PASSWORD yok sayılır. Şifre değişince açık oturumlar kapanır.
SUPERADMIN_PASSWORD_HASH=
# SUPERADMIN_PASSWORD=
# Oturum cookie'sini imzalamak için uzun rastgele değer (openssl rand -hex 32)
SUPERADMIN_SECRET_KEY=

# ── Abonelik satış kanalı ─────────────────────────────────────────────────
# Web'de iyzico ile satış. Varsayılan kapalı: abonelik mobil uygulamadan
# (App Store / Google Play) alınır. Şirket kurulunca "true" yapılabilir.
WEB_BILLING_ENABLED=false
# Uygulama yayınlanınca mağaza sayfaları (boşsa billing sayfasında "yakında" yazar)
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# ── Mobil push (Expo) ─────────────────────────────────────────────────────
# Yalnızca Expo hesabında "enhanced push security" açıksa gerekir
EXPO_ACCESS_TOKEN=

# ── iyzico (WEB_BILLING_ENABLED=true iken) ───────────────────────────────
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ── E-posta (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
# Resend'de doğrulanmış domain
EMAIL_FROM="BerberBot <destek@berberbot.com>"

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# Webhook imza doğrulaması (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=

# ── Upstash Redis (hız sınırı) ────────────────────────────────────────────
# Production'da zorunlu: yoksa hız sınırı yalnızca sunucu örneği belleğinde tutulur
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
