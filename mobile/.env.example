# Kopyalayıp .env.local olarak kaydedin. EXPO_PUBLIC_ ile başlayanlar uygulama
# paketine gömülür: buraya yalnızca herkese açık değerler yazılır (service role YOK).

# Web projesindeki NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY ile aynı
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mobil API'nin (/api/mobile/v1) bulunduğu Next.js sunucusu.
# Android emülatörü: http://10.0.2.2:3000 (emülatörde "localhost" emülatörün kendisidir)
# Fiziksel telefon: bilgisayarın yerel ağ IP'si (ipconfig → IPv4, ör. http://192.168.1.20:3000)
# Tarayıcı önizlemesi (npm run web): http://localhost:3000. Canlıda: https://berberbot.com
# Değiştirdikten sonra Metro'yu önbelleği temizleyerek yeniden başlatın: npx expo start -c
EXPO_PUBLIC_API_URL=http://localhost:3000

# Randevu linklerinin gösterileceği site adresi (berberbot.com/<slug>)
EXPO_PUBLIC_SITE_URL=https://berberbot.com

# Profil ekranındaki destek adresi (web: lib/site-config.ts → SUPPORT.email)
EXPO_PUBLIC_SUPPORT_EMAIL=destek@berberbot.com

# RevenueCat herkese açık SDK anahtarları (Project settings → API keys → Public app-specific).
# Boşsa abonelik ekranı "satın alma kullanılamıyor" gösterir. Gizli anahtar (sk_) buraya YAZILMAZ.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
